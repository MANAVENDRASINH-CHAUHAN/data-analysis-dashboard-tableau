      <aliases enabled='yes' />
      <column caption='Python Status' datatype='string' name='[Calculation_1350119254700032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Skills]), &quot;python&quot;) THEN &quot;Has Skill&quot; ELSE &quot;Missing&quot; END' />
      </column>
      <column caption='SQL Status' datatype='string' name='[Calculation_1350119255769089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Skills]), &quot;sql&quot;) THEN &quot;Has Skill&quot; ELSE &quot;Missing&quot; END' />
      </column>
      <column caption='Excel Status' datatype='string' name='[Calculation_1350119258013698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Skills]) AND &#10;(&#10;CONTAINS(LOWER([Skills]), &quot;excel&quot;) &#10;OR CONTAINS(LOWER([Skills]), &quot;spreadsheet&quot;)&#10;)&#10;THEN &quot;Has Skill&quot;&#10;ELSE &quot;Missing&quot;&#10;END' />
      </column>
      <column caption='Power BI Status' datatype='string' name='[Calculation_1350119258116099]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Skills]) AND &#10;(&#10;CONTAINS(LOWER([Skills]), &quot;power bi&quot;) &#10;OR CONTAINS(LOWER([Skills]), &quot;powerbi&quot;)&#10;)&#10;THEN &quot;Has Skill&quot;&#10;ELSE &quot;Missing&quot;&#10;END' />
      </column>
      <column caption='Match Score' datatype='integer' name='[Calculation_1350119258451972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;IF NOT ISNULL([Skills]) AND CONTAINS(LOWER([Skills]), &quot;python&quot;) THEN 25 ELSE 0 END&#10;+&#10;IF NOT ISNULL([Skills]) AND CONTAINS(LOWER([Skills]), &quot;sql&quot;) THEN 25 ELSE 0 END&#10;+&#10;IF NOT ISNULL([Skills]) AND &#10;(&#10;CONTAINS(LOWER([Skills]), &quot;excel&quot;) &#10;OR CONTAINS(LOWER([Skills]), &quot;spreadsheet&quot;)&#10;)&#10;THEN 25 ELSE 0 END&#10;+&#10;IF NOT ISNULL([Skills]) AND &#10;(&#10;CONTAINS(LOWER([Skills]), &quot;power bi&quot;) &#10;OR CONTAINS(LOWER([Skills]), &quot;powerbi&quot;)&#10;)&#10;THEN 25 ELSE 0 END&#10;)' />
      </column>
      <column datatype='string' name='[Name]' role='dimension' type='nominal' />
      <column caption='Resume ID' datatype='integer' name='[Resume_ID]' role='dimension' type='ordinal' />
      <column caption='Skills - Split 1' datatype='string' name='[Skills - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.0zfrmf10wfwrgn10qh46m0pf76gy].[Skills]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Skills], &quot;,&quot;, 1 ) )' />
      </column>
      <column caption='Skills - Split 2' datatype='string' name='[Skills - Split 2]' role='dimension' type='nominal' user:SplitFieldIndex='2' user:SplitFieldOrigin='[federated.0zfrmf10wfwrgn10qh46m0pf76gy].[Skills]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Skills], &quot;,&quot;, 2 ) )' />
